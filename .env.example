# AnestIA — variables de entorno (piloto). Copiar a .env y rellenar. NUNCA commitear .env.

# Base de datos (PostgreSQL 16 + pgvector, instalación LTS local)
DATABASE_URL="postgresql://jdh@localhost:5432/anestia"

# Sesión (firma de cookie). Generar: openssl rand -base64 32
SESSION_SECRET=""

# Seed: contraseña inicial de Luquetta. Si se deja vacía, el seed genera una y la imprime UNA vez.
SEED_ADMIN_PASSWORD=""

# Adaptadores (piloto): stub/local hasta integrar credenciales reales
AI_PROVIDER="stub"          # stub | anthropic
STORAGE_PROVIDER="local"    # local | s3
MAILER_PROVIDER="stub"      # stub | gmail-smtp

# Diferidos (se piden cuando su fase lo requiera):
# ANTHROPIC_API_KEY=""      # Fase 2-3 (motor clínico / visión de labs)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER=""              # correo Gmail
# SMTP_PASS=""              # Gmail App Password (Fase 6)
# Google Sheets (export opcional) — service account

# Storage local
STORAGE_DIR="./storage"

# Origen público de la app — se usa en los deep-links del recordatorio matutino de cirugías.
# El cron no tiene el request, por eso el origin viene de aquí (el resto de la app lo deriva
# del request). CAMBIAR EN PRODUCCIÓN al dominio real (p. ej. https://anestia.tudominio.com).
APP_ORIGIN="http://localhost:3000"
