{
  "name": "anestia",
  "version": "0.1.0",
  "private": true,
  "description": "AnestIA — plataforma de valoración preanestésica automatizada (piloto)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/api & npm run start --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run start --workspace apps/web",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "generate": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "worker": "npm run worker --workspace apps/api",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test --workspace apps/api",
    "anestesiologo": "tsx prisma/crear-anestesiologo.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
